@baseUrl = http://localhost:3001/api/v1
@contentType = application/json

# Save variables manually
@accessToken = YOUR_ACCESS_TOKEN_HERE
@movieId = YOUR_MOVIE_ID_HERE
@watchlistId = YOUR_WATCHLIST_ID_HERE

### ----------------------------------------------------------------
### AUTH MODULE
### ----------------------------------------------------------------

### 1. Register User
POST {{baseUrl}}/auth/register
Content-Type: {{contentType}}

{
  "name": "Cyrene",
  "email": "cyrene@hoyohsr.com",
  "password": "#Rene321"
}

### 2. Login User
POST {{baseUrl}}/auth/login
Content-Type: {{contentType}}

{
  "email": "khaslana@hoyohsr.com",
  "password": "#Khas123"
}

### 3. Get Current User Profile (Me)
GET {{baseUrl}}/auth/me
Authorization: Bearer {{accessToken}}

### 4. Refresh Token
POST {{baseUrl}}/auth/refresh

### 5. Logout User
POST {{baseUrl}}/auth/logout

### ----------------------------------------------------------------
### MOVIE MODULE (Requires Bearer Access Token)
### ----------------------------------------------------------------

### 1. Add Movie
POST {{baseUrl}}/movies
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "title": "Thor: Ragnarok",
  "overview": "Thor must escape a gladiator planet and reunite with Hulk to stop his sister, Hela, from destroying Asgard.",
  "releaseYear": 2017,
  "genres": ["ACTION", "ADVENTURE"],
  "runtime": 130,
  "posterUrl": "https://example.com/thor.jpg"
}

### 2. Get Movies
GET {{baseUrl}}/movies
Authorization: Bearer {{accessToken}}

### 3. Get Movies with Filter & Pagination
GET {{baseUrl}}/movies?search=&releaseYear=&genres=&page=&limit=
Authorization: Bearer {{accessToken}}

### 4. Get Movie Details
GET {{baseUrl}}/movies/{{movieId}}
Authorization: Bearer {{accessToken}}

### 5. Edit Movie
PUT {{baseUrl}}/movies/{{movieId}}
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "title": "Thor: Love and Thunder",
  "overview": "Thor teams up with his ex-girlfriend, Jane Foster—now wielding Mjolnir—to stop Gorr the God Butcher from killing all gods.",
  "releaseYear": 2022,
  "runtime": 119
}

### 6. Delete Movie
DELETE {{baseUrl}}/movies/{{movieId}}
Authorization: Bearer {{accessToken}}

### ----------------------------------------------------------------
### WATCHLIST MODULE (Requires Bearer Access Token)
### ----------------------------------------------------------------

### 1. Add Item to Watchlist
POST {{baseUrl}}/watchlists
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "movieId": "{{movieId}}",
  "status": "WATCHING",
  "rating": 5,
  "notes": "The movie is excellent!"
}

### 2. Get Watchlist Items (Default Page 1, Limit 10)
GET {{baseUrl}}/watchlists
Authorization: Bearer {{accessToken}}

### 3. Get Watchlist Items with Filter & Pagination
GET {{baseUrl}}/watchlists?status=WATCHING&page=1&limit=5
Authorization: Bearer {{accessToken}}

### 4. Edit Watchlist Item
PUT {{baseUrl}}/watchlists/{{watchlistId}}
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "status": "COMPLETED",
  "rating": 5,
  "notes": "Finished watching it."
}

### 5. Delete Watchlist Item
DELETE {{baseUrl}}/watchlists/{{watchlistId}}
Authorization: Bearer {{accessToken}}
