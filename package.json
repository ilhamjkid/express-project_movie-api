{
  "name": "backend-course",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.16.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "imports": {
    "#prisma/*": {
      "types": "./src/generated/prisma/*.ts",
      "default": "./dist/generated/prisma/*.js"
    },
    "#config/*": {
      "types": "./src/config/*.ts",
      "default": "./dist/config/*.js"
    },
    "#errors/*": {
      "types": "./src/errors/*.ts",
      "default": "./dist/errors/*.js"
    },
    "#middleware/*": {
      "types": "./src/middleware/*.ts",
      "default": "./dist/middleware/*.js"
    },
    "#modules/*": {
      "types": "./src/modules/*.ts",
      "default": "./dist/modules/*.js"
    },
    "#utils/*": {
      "types": "./src/utils/*.ts",
      "default": "./dist/utils/*.js"
    },
    "#routes": {
      "types": "./src/routes/index.ts",
      "default": "./dist/routes/index.js"
    },
    "#app": {
      "types": "./src/app.ts",
      "default": "./dist/app.js"
    }
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ms": "^2.1.0",
    "@types/node": "^26.1.1",
    "prisma": "^7.9.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@prisma/adapter-neon": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "ms": "^2.1.3",
    "zod": "^4.4.3"
  }
}
